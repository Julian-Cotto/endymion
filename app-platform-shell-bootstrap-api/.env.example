APP_ENV=local
BOOTSTRAP_MODE=registry

APP_CONFIGURATION_ENDPOINT=
APP_CONFIGURATION_LABEL=local

REGISTRY_BASE_URL=http://localhost:8010
# REGISTRY_READ_TOKEN=   # optional Bearer for registry HTTP

CACHE_BACKEND=memory
CACHE_TTL_SECONDS=30
REDIS_URL=redis://localhost:6379/0

INCLUDE_FLAG_PREFIXES_CSV=shell.,asset-inventory.,orders.,catalog.
CORS_ALLOW_ORIGINS_CSV=http://localhost:3000,http://localhost:3200,http://localhost:3300,http://localhost:5173

# ---------------------------------------------------------------------
# Auth mode
# ---------------------------------------------------------------------
# mock  = local/dev identity, optional X-Debug-* headers
# local = local signed JWT validation, optional X-Debug-* headers
# entra = production Entra/JWKS validation, no debug overrides
AUTH_MODE=mock
REQUIRE_AUTH=true

# ---------------------------------------------------------------------
# Mock/local development authorization
# ---------------------------------------------------------------------
# Roles are permission-shaped.
# These values should match Entra app role values used in production.
# Local dev: include every permission required by features in your local registry
# (BootstrapService treats roles as permissions; missing perms hide the feature).
DEV_DEFAULT_ROLES_CSV=orders.view,catalog.view
DEV_ALLOW_DEBUG_HEADERS=true

# Optional local request headers:
# X-Debug-User-Id: local-dev
# X-Debug-User-Name: Local Developer
# X-Debug-Email: dev@local
# X-Debug-Roles: orders.view,catalog.view

# ---------------------------------------------------------------------
# Local JWT validation
# ---------------------------------------------------------------------
LOCAL_JWT_SECRET=local-dev-secret
LOCAL_JWT_ALGORITHM=HS256

AUTH_ISSUER=https://issuer.example.com
AUTH_AUDIENCE=api://shell-bootstrap
AUTH_ALLOWED_ALGS_CSV=HS256
AUTH_JWKS_URL=

AUTH_ROLES_CLAIM=roles
AUTH_USER_ID_CLAIM=sub
AUTH_USER_NAME_CLAIM=name
AUTH_EMAIL_CLAIM=email
AUTH_GROUPS_CLAIM=groups
AUTH_SCOPE_CLAIM=scp
AUTH_WIDS_CLAIM=wids

# ---------------------------------------------------------------------
# Production Entra/JWKS validation
# ---------------------------------------------------------------------
# In production, Entra app role values are platform permissions directly.
#
# Examples:
#   orders.view
#   orders.create
#   orders.edit
#   catalog.view
#   catalog.edit
#   platform.admin
#
# Bootstrap does not use:
#   scope -> role mapping
#   group -> role mapping
#   role  -> permission mapping
#
# AUTH_MODE=entra
# DEV_ALLOW_DEBUG_HEADERS=false
# AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_AUDIENCE=api://<bootstrap-api-client-id>
# AUTH_ALLOWED_ALGS_CSV=RS256
# AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

PLATFORM_ADMIN_ROLE=platform.admin