        },
        "authorization": {
          "requiredPermissions": ["orders.view"],
          "requiredFlags": ["orders.enabled"]
        },
        "auth": {
          "required": true,
          "mode": "mock",
          "shellAuthRequired": true,
          "tokenForwarding": false
        }
      }
    ]
  }