{
    "features": [
      {
        "featureKey": "orders",
        "displayName": "Orders",
        "route": "/orders",
        "version": "1.0.0",
        "nav": {
          "label": "Orders",
          "icon": "package"
        },
        "frontend": {
          "enabled": true,
          "entryUrl": "http://localhost:3200/src/bootstrap-entry.tsx",
          "mountFunction": "mount"
        },
        "backend": {
          "enabled": true,
