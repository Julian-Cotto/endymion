from functools import lru_cache
from pydantic_settings import BaseSettings, SettingsConfigDict

class JobSettings(BaseSettings):
    model_config = SettingsConfigDict(env_prefix="[[ names.feature_key | replace('-', '_') | upper ]]_", extra="ignore")
    feature_key: str = "[[ names.feature_key ]]"
    job_name: str = "[[ target_name ]]"
    schedule: str = "[[ target_schedule ]]"
    log_level: str = "INFO"

@lru_cache(maxsize=1)
def get_job_settings() -> JobSettings:
    return JobSettings()
