# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
APP_ENVIRONMENT=production
SERVICE_NAME=[[ names.display_name ]] Service
FEATURE_KEY=[[ names.feature_key ]]
API_BASE_PATH=[[ names.api_base_path ]]

# ---------------------------------------------------------------------
# Production auth
# ---------------------------------------------------------------------
AUTH_MODE=entra
AUTH_DEBUG_HEADERS_ENABLED=false

# ---------------------------------------------------------------------
# Permission convention
# ---------------------------------------------------------------------
# Entra app role value == platform permission.
#
# Examples:
#   [[ names.feature_key ]].view
#   [[ names.feature_key ]].create
#   [[ names.feature_key ]].edit
#   platform.admin
#
# platform.admin grants full access.
PLATFORM_ADMIN_ROLE=platform.admin

# Default permission used by generated sample endpoints.
AUTH_REQUIRED_PERMISSIONS_RAW=[[ names.feature_key ]].view

# ---------------------------------------------------------------------
# Entra token validation
# ---------------------------------------------------------------------
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<feature-api-or-bootstrap-api-client-id>
ENTRA_AUDIENCE=api://<bootstrap-api-client-id>
ENTRA_ALLOWED_AUDIENCES_RAW=

ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_ALLOWED_ISSUERS_RAW=

ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# ---------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------
ALLOWED_ORIGINS_RAW=https://portal.example.com