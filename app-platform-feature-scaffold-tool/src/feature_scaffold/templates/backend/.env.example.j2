# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
APP_ENVIRONMENT=local
SERVICE_NAME=[[ names.display_name ]] Service
FEATURE_KEY=[[ names.feature_key ]]
API_BASE_PATH=[[ names.api_base_path ]]

# ---------------------------------------------------------------------
# Auth mode
# ---------------------------------------------------------------------
# none  = no auth (testing only)
# mock  = local dev with debug headers / default roles
# entra = production Entra JWT validation
AUTH_MODE=mock

# ---------------------------------------------------------------------
# Local / Mock configuration
# ---------------------------------------------------------------------
# These roles MUST match Entra app role values used in production.
# They are permission-shaped.
AUTH_DEFAULT_DEV_ROLES_RAW=[[ names.feature_key ]].view

# Enable/disable debug headers:
# X-Debug-User-Id
# X-Debug-User-Name
# X-Debug-Email
# X-Debug-Roles
AUTH_DEBUG_HEADERS_ENABLED=true

AUTH_DEFAULT_DEV_USER_ID=dev-user
AUTH_DEFAULT_DEV_USER_NAME=Local Dev User
AUTH_DEFAULT_DEV_EMAIL=dev@example.local

# ---------------------------------------------------------------------
# Permission convention
# ---------------------------------------------------------------------
# Entra app role value == platform permission
#
# Examples:
#   [[ names.feature_key ]].view
#   [[ names.feature_key ]].create
#   [[ names.feature_key ]].edit
#   platform.admin
#
# platform.admin grants full access
PLATFORM_ADMIN_ROLE=platform.admin

# Default permission used by generated endpoints
AUTH_REQUIRED_PERMISSIONS_RAW=[[ names.feature_key ]].view

# ---------------------------------------------------------------------
# Entra configuration (production)
# ---------------------------------------------------------------------
# Required when AUTH_MODE=entra

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ALLOWED_AUDIENCES_RAW=

ENTRA_ISSUER=
ENTRA_ALLOWED_ISSUERS_RAW=

ENTRA_JWKS_URL=

# ---------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:3200,http://localhost:3300,http://localhost:5173
{% if cache_enabled and redis_enabled %}

# ---------------------------------------------------------------------
# Cache (Redis)
# ---------------------------------------------------------------------
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
{% endif %}