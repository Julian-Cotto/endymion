# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
APP_ENVIRONMENT=local
SERVICE_NAME=Lead Locator Service
FEATURE_KEY=lead-locator
API_BASE_PATH=/api/leads

# ---------------------------------------------------------------------
# Auth mode
# ---------------------------------------------------------------------
# none  = no auth (testing only)
# mock  = local dev with debug headers / default roles
# entra = production Entra JWT validation
AUTH_MODE=mock

# ---------------------------------------------------------------------
# Local / Mock configuration
# ---------------------------------------------------------------------
# These roles MUST match Entra app role values used in production.
# They are permission-shaped.
AUTH_DEFAULT_DEV_ROLES_RAW=lead-locator.view

# Enable/disable debug headers:
# X-Debug-User-Id
# X-Debug-User-Name
# X-Debug-Email
# X-Debug-Roles
AUTH_DEBUG_HEADERS_ENABLED=true

AUTH_DEFAULT_DEV_USER_ID=dev-user
AUTH_DEFAULT_DEV_USER_NAME=Local Dev User
AUTH_DEFAULT_DEV_EMAIL=dev@example.local

# ---------------------------------------------------------------------
# Permission convention
# ---------------------------------------------------------------------
# Entra app role value == platform permission
#
# Examples:
#   lead-locator.view
#   lead-locator.create
#   lead-locator.edit
#   platform.admin
#
# platform.admin grants full access
PLATFORM_ADMIN_ROLE=platform.admin

# Default permission used by generated endpoints
AUTH_REQUIRED_PERMISSIONS_RAW=lead-locator.view

# ---------------------------------------------------------------------
# Entra configuration (production)
# ---------------------------------------------------------------------
# Required when AUTH_MODE=entra

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ALLOWED_AUDIENCES_RAW=

ENTRA_ISSUER=
ENTRA_ALLOWED_ISSUERS_RAW=

ENTRA_JWKS_URL=

# ---------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------
# Census ACS API key. REQUIRED for the demographics/demand term — every ACS
# request without one is redirected to missing_key.html, including the
# simplest query. Free and instant: https://api.census.gov/data/key_signup.html
# Without it, searches still resolve, tile, fetch POIs and score traffic —
# they just have no demand term.
CENSUS_API_KEY=
CENSUS_ACS_YEAR=2023

# Geocoding uses Census TIGERweb (keyless, US-only, real polygons).
# Nominatim is NOT used: it 403s this client and its policy caps automated use.
GEOCODER_PROVIDER=tigerweb

# Identify yourself to the public endpoints. Override with a real contact.
GEOCODER_USER_AGENT=endymion-lead-locator/0.1 (dev@example.local)

# POIs from OpenStreetMap via Overpass — a free, shared, rate-limited endpoint.
# Mirrors are tried in turn when the primary is loaded (it returns 406/504
# for valid queries under load).
POI_PROVIDER=overpass
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# "modeled" = the free traffic proxy (POI density + category weights + decay).
# NOT measured foot traffic. A paid feed (Placer/SafeGraph) registers here.
TRAFFIC_PROVIDER=modeled

# res 8 ~= 0.74 km2 (city overview); res 9 ~= 0.11 km2 (block level).
DEFAULT_H3_RESOLUTION=8

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# PostGIS, not plain Postgres — scoring stores POI/tract geometry and does
# distance + containment queries. Start it with:
#   (cd feature-lead-locator && docker compose up -d --wait)
DATABASE_URL=postgresql://leads:leads@localhost:5435/lead_locator

# ---------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:3600,http://localhost:5173
