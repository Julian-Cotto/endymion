# Copy to ".env.local" for local overrides (Vite loads .env.local automatically).

# mock (default) | entra
# VITE_AUTH_MODE=mock

VITE_RUNTIME_SOURCE_MODE=bootstrap
VITE_BOOTSTRAP_URL=http://localhost:8765/api/runtime/features
VITE_REGISTRY_RUNTIME_URL=http://localhost:8010/api/runtime/features?environment=local

# Mock mode: Bearer token forwarded to features. Any non-empty string works locally.
VITE_MOCK_ACCESS_TOKEN=mock-dev-token

# Mock mode: identity + roles forwarded to feature backends via X-Debug-* headers.
# Roles must include every permission a feature backend checks, plus literal
# admin/developer for any feature that has admin-bypass paths (e.g. continued-ed
# Approvals queue, full-org views). Keep aligned with bootstrap-api
# DEV_DEFAULT_ROLES_CSV when running registry-mode locally.
# VITE_MOCK_USER_ID=local-dev
# VITE_MOCK_USER_NAME=Local Developer
# VITE_MOCK_EMAIL=dev@local
# VITE_MOCK_ROLES=admin,developer,orders.view,catalog.view

# Entra mode (see src/platform/auth/msalConfig.ts)
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_AUTHORITY=
# VITE_ENTRA_SCOPES=
# VITE_ENTRA_REDIRECT_URI=http://localhost:3000
