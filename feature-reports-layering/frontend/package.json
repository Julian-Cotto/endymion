{
  "name": "@company/feature-reports-layering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3500",
    "build": "npm run build:app && npm run build:mf",
    "build:app": "vite build --mode app",
    "build:mf": "vite build --mode mf",
    "preview": "vite preview --port 3500",
    "test": "vitest run",
    "publish:local": "cd .. && bash scripts/publish-local.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}